{
  "rules": {
    ".read": false,
    ".write": false,

    "_aciklama": [
      "Okuma yalnız panel hesabına açık: PANEL_UID yerine Firebase Console →",
      "Authentication → Users listesindeki kullanıcı UID'sini yaz.",
      "Yazma kimliksiz kalıyor, çünkü uygulamada giriş yok — kayıtlar yalnız",
      "oluşturulabiliyor, üzerine yazılamıyor ve silinemiyor."
    ],

    "panel": {
      ".read":  "auth != null && auth.uid === 'PANEL_UID'",
      ".write": "auth != null && auth.uid === 'PANEL_UID'"
    },

    "devices": {
      ".read": "auth != null && auth.uid === 'PANEL_UID'",

      "$did": {
        "events": {
          "$batch": {
            ".write": "!data.exists() && newData.exists()",
            ".validate": "newData.hasChildren(['e','n']) && newData.child('n').isNumber() && newData.child('n').val() > 0 && newData.child('n').val() <= 60"
          }
        },

        "sessionEnds": {
          "$id": {
            ".write": "!data.exists() && newData.exists()",
            ".validate": "newData.hasChildren(['end','durMs'])"
          }
        },

        "sessions": {
          "$sid": {
            ".write": "newData.exists()",
            ".validate": "newData.hasChildren()",
            "start":    { ".validate": "newData.isNumber()" },
            "end":      { ".validate": "newData.isNumber()" },
            "durMs":    { ".validate": "newData.isNumber()" },
            "activeMs": { ".validate": "newData.isNumber()" }
          }
        }
      }
    }
  }
}
